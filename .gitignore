# ===== 根级锁定文件（必须受版本控制） =====
# pnpm-lock.yaml 不再忽略，作为根级统一锁文件
# 禁止生成 package-lock.json
package-lock.json

# ===== 前端构建产物（当前或未来根级项目） =====
node_modules
dist
*.local
.env.local
.env.*.local

# ===== 后端构建产物（当前或未来根级项目） =====
target
*.class
*.jar
*.war

# ===== 遗留参考区生成产物与锁文件 =====
old/**/node_modules
old/**/dist
old/**/target
old/**/*.class
old/**/*.jar
old/**/*.war
old/**/package-lock.json
old/**/.env.local
old/**/.env.*.local

